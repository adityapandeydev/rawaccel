{
  "name": "rawaccel-userspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "test:math": "node --test scripts/math.test.mjs",
    "test:ui": "npm run build && node scripts/check-ui.cjs",
    "bundle:windows": "tauri build --bundles nsis -- --locked && node scripts/check-installer.cjs",
    "bundle:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "test:math-reference": "python scripts/check_math_reference.py",
    "test:driver-status": "node --test scripts/driver-status.test.mjs",
    "test:abi": "python scripts/check_driver_abi.py",
    "test:validation": "node --test scripts/validation.test.mjs",
    "test:settings-defaults": "node --test scripts/settings-defaults.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.37.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
